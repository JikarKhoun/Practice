/* Group switch
Month Days

Write a program that reads an integer month number (1–12) and prints how many days that month has, using switch with grouped cases.

1, 3, 5, 7, 8, 10, 12 → 31 days
4, 6, 9, 11 → 30 days
2 → 28 or 29 days
otherwise → Invalid month */

#include <stdio.h>

int main () 
{

int number;

//printf("Give day number: ");
scanf("%d", &number);

switch (number){
case 1:  case 3:  case 5: case 7: case 8: case 10: case 12:
printf("31 days");
break;
case 4: case 6: case 9: case 11:
printf("30 days");
break;
case 2:
printf("28 or 29 days");
break;

default:
printf("Invalid month");


}
return 0;

}
