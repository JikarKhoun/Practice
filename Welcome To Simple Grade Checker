#include <stdio.h>
int main (void)
{

printf("****Welcome To Simple Grade Checker****\n");

int score; 
int again;

printf("\nEnter your score 1 - 100: ");
scanf("%d", &score);

while (score <= 0) {
    printf("Please give correct score 1 - 100: ");
    scanf("%d", &score);
}

if(score > 0 ){
if (score >= 90 && score <= 100) {
    printf("Excellent");
}

 else if (score >= 75 && score <= 89) {
    printf("Good");
}

 else if (score >= 50 && score <= 74) {
    printf("Pass");
}

 else if (score >= 0 && score <= 49) {
    printf("Fail");
}
 else {
    printf("Invalid score!!");
 }

}
