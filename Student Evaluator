#include <stdio.h>
int main (void) 
{

int age;
float grade;
char level;
char passFail;

//input

printf("How old are you? ");
scanf("%d", &age);

printf("Give your grade from 0.0 to 10.0: ");
scanf("%f", &grade);

printf("What is your level B or I or A? ");
scanf(" %c", &level);


//age 
if (age < 13 ) {
printf("You are a kid learner.\n");
}
else if (age >= 13 && age <= 17 ) {
    printf("You are a teen learner.\n");
}
else {
    printf("You are an adult learner.\n");
}

//grade 
if (grade >= 8.0) {
    passFail = 'P';
}
else {
    passFail = 'F';
}

 if (passFail == 'P') {
        printf("Result: Pass\n");
    } else  {
        printf("Result: Fail\n");
    }
   

//LEVEL 
switch (level) {
    case 'B':
    printf("Beginner level.\n");
    break;

    case 'I':
    printf("Intermediate level.\n");
    break;

    case 'A':
    printf("Advanced level.\n");
    break;

    default:
    printf("Level invalid.\n");
    break;

}


return 0;

}






